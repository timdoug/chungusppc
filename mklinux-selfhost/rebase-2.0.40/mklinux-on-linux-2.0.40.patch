+static int
+sound_read (inode_handle * inode, file_handle * file, char *buf, int count)
+{
+  int             dev;
+
+  dev = MINOR (inode_get_rdev (inode));
+
+  files[dev].flags = file_get_flags (file);
+
+  return sound_read_sw (dev, &files[dev], buf, count);
+}
