+ * MkLinux
+ */
+
+#ifndef _ASM_OSFMACH3_PPC_UNISTD_H
+#define _ASM_OSFMACH3_PPC_UNISTD_H
+
+#undef __KERNEL_SYSCALLS__
+#include <asm-ppc/unistd.h>
+
+#undef _syscall0
+#undef _syscall1
+#undef _syscall2
+#undef _syscall3
+#undef _syscall4
+#undef _syscall5
+
+#define _syscall0(type,name) \
+type name(void) \
+{ \
