+
+arch/$(ARCH)/server: dummy
+	$(MAKE) linuxsubdirs SUBDIRS=arch/$(ARCH)/server
+
+MAKEBOOT = $(MAKE) -C arch/$(ARCH)/boot
+
+zImage: vmlinux
+	@$(MAKEBOOT) zImage
+
+bzImage: vmlinux
+	@$(MAKEBOOT) bzImage
+
+compressed: zImage
+
+zlilo: vmlinux
+	@$(MAKEBOOT) BOOTIMAGE=zImage zlilo
+
+bzlilo: vmlinux
+	@$(MAKEBOOT) BOOTIMAGE=bzImage zlilo
+
+zdisk: vmlinux
+	@$(MAKEBOOT) BOOTIMAGE=zImage zdisk
+
+bzdisk: vmlinux
