+	int	fb_offset;
+	int	pitch[3];
+	unsigned regs[26];
+	unsigned char plat_offset[3];
+	unsigned char mode[3];
+	unsigned char dacula_ctrl[3];
+	unsigned char clocksel[2][2];
+ };
