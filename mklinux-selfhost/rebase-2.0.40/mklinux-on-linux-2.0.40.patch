+			      PPC_FLOAT_STATE,
+			      (thread_state_t)fpregs,
+			      &count);
+	server_thread_unblocking(FALSE);
+	if (kr != KERN_SUCCESS) {
+		MACH3_DEBUG(1, kr,
+			    ("dump_fpu: "
+			     "thread_get_state(0x%x)",
+			     child_thread));
+	}
+
+	return 1;
