+				    (mach_port_t)            devc->reply_port,
+				    (dev_mode_t)             D_READ,
+				    (recnum_t)               0,
+				    (caddr_t)                buf,
+				    (mach_msg_type_number_t) count,
+				    (boolean_t)              FALSE);
+
+	if (kr != KERN_SUCCESS) {
