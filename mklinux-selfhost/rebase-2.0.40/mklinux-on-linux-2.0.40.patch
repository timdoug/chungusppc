+/*
+ * Space allocation and freeing routines for use by zlib routines.
+ */
+void
+zfree(arg, ptr)
+    void *arg;
+    void *ptr;
+{
+	struct chunk_header *hdr = ((struct chunk_header *)ptr) - 1;
