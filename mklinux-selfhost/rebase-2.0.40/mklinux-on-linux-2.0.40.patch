 		return 0;
+#ifdef	CONFIG_PMAC_CONSOLE
+	case VC_GETMODE:
+		{
+#ifdef	CONFIG_OSFMACH3
+			extern int console_getmode(struct vc_mode *mode);
+#endif	/* CONFIG_OSFMACH3 */
+			struct vc_mode mode;
+
+			i = verify_area(VERIFY_WRITE, (void *) arg,
+					sizeof(struct vc_mode));
+			if (i == 0)
+				i = console_getmode(&mode);
+			if (i)
+				return i;
+			memcpy_tofs((void *) arg, &mode, sizeof(mode));
+			return 0;
+		}
+	case VC_SETMODE:
+	case VC_INQMODE:
+		{
+#ifdef	CONFIG_OSFMACH3
+			extern int console_setmode(struct vc_mode *mode,
+						   int doit);
+#endif	/* CONFIG_OSFMACH3 */
+			struct vc_mode mode;
+
+			if (!suser())
+				return -EPERM;
+			i = verify_area(VERIFY_READ, (void *) arg,
+					sizeof(struct vc_mode));
+			if (i)
+				return i;
+			memcpy_fromfs(&mode, (void *) arg, sizeof(mode));
+			return console_setmode(&mode, cmd == VC_SETMODE);
+		}
+#ifdef	CONFIG_OSFMACH3
+	case VC_SETCMAP:
+	case VC_GETCMAP:
+		{
+			extern int console_set_get_cmap(void *cmap, int doset);
+
+			if (!suser())
+				return -EPERM;
+			return console_set_get_cmap((void *) arg,
+						    cmd == VC_SETCMAP);
+		}
+#endif	/* CONFIG_OSFMACH3 */
+#endif	/* CONFIG_PMAC_CONSOLE */
 	default:
 		return -ENOIOCTLCMD;
 	}
