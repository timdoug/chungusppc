-static FileOperations_T
-  DAC960_FileOperations =
-    { lseek:		    NULL,
-      read:		    block_read,
-      write:		    block_write,
-      readdir:		    NULL,
-      select:		    NULL,
-      ioctl:		    DAC960_Ioctl,
-      mmap:		    NULL,
-      open:		    DAC960_Open,
-      release:		    DAC960_Release,
-      fsync:		    block_fsync,
-      fasync:		    NULL,
-      check_media_change:   NULL,
-      revalidate:	    NULL };
