+	stw	r0,0(r3)
+	mr	r3,r0
+	blr
+#endif /* !CONFIG_OSFMACH3 */	
+
+/*
+ * Restore 'flags'
+ *	__restore_flags(long val)
+ */
+_GLOBAL(__restore_flags)
+#ifdef 	CONFIG_OSFMACH3
+	li	r3,0		/* NULL - stub */
+	blr
+#else	
+	sync			/* Some chip revs have problems here... */
+	mtmsr	r3
+	isync
+	blr
+#endif /* !CONFIG_OSFMACH3 */	
+
+/*
+ * Disable interrupts - like an 80x86
