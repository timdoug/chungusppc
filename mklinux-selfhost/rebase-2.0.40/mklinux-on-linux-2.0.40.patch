+char * sys_call_name_table[] = {
+	"setup",		/* 0 */
+	"exit",
+	"fork",
+	"read",
+	"write",
+	"open",			/* 5 */
+	"close",
+	"waitpid",
+	"creat",
+	"link",
+	"unlink",		/* 10 */
+	"execve",
+	"chdir",
+	"time",
+	"mknod",
+	"chmod",		/* 15 */
+	"chown",
+	"break",
+	"stat",
+	"lseek",
+	"getpid",		/* 20 */
+	"mount",
+	"umount",
+	"setuid",
+	"getuid",
+	"stime",		/* 25 */
+	"ptrace",
+	"alarm",
+	"fstat",
+	"pause",
+	"utime",		/* 30 */
+	"stty",
+	"gtty",
+	"access",
+	"nice",
+	"ftime",		/* 35 */
+	"sync",
+	"kill",
+	"rename",
+	"mkdir",
+	"rmdir",		/* 40 */
+	"dup",
+	"pipe",
+	"times",
+	"prof",
+	"brk",			/* 45 */
+	"setgid",
+	"getgid",
+	"signal",
+	"geteuid",
+	"getegid",		/* 50 */
+	"acct",
+	"phys",
+	"lock",
+	"ioctl",
+	"fcntl",		/* 55 */
+	"mpx",
+	"setpgid",
+	"ulimit",
+	"olduname",
+	"umask",		/* 60 */
+	"chroot",
+	"ustat",
+	"dup2",
+	"getppid",
+	"getpgrp",		/* 65 */
+	"setsid",
+	"sigaction",
+	"sgetmask",
+	"ssetmask",
+	"setreuid",		/* 70 */
+	"setregid",
+	"sigsuspend",
+	"sigpending",
+	"sethostname",
