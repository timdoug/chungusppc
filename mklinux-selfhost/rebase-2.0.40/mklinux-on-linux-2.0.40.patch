+	if (deflateInit2(&state->strm, Z_DEFAULT_COMPRESSION,
+			 DEFLATE_METHOD_VAL, -w_size, 8, Z_DEFAULT_STRATEGY)
+	    != Z_OK)
+		goto out_free;
+	state->strm.zalloc = zalloc;
+	return (void *) state;
+
+out_free:
+	z_comp_free(state);
+	MOD_DEC_USE_COUNT;
+	return NULL;
