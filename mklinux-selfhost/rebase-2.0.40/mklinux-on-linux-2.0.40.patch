+	kr = mach_port_move_member(mach_task_self(),
+				   trap_port,
+				   ux_server_loop_pset);
+	if (kr != KERN_SUCCESS) {
+		MACH3_DEBUG(1, kr, ("ux_server_add_port: "
+				    "mach_port_move_member(%x, %x)",
+				    trap_port, ux_server_loop_pset));
+		panic("ux_server_loop_add: can't add trap port to pset");
+	}
+}
