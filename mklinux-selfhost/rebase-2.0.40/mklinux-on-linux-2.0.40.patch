+
+	if (in_kernel) {
+		task_port = current->osfmach3.task->mach_task_port;
+		server_thread_blocking(TRUE);
+#ifdef i386
+		/* stupid COPYIN macro */
+		error = COPYIN(task_port, from, to, count);
+#else	/* i386 */
+		error = COPYIN(task_port,
+			       (vm_offset_t) from, (vm_offset_t) to, count);
+#endif	/* i386 */
+		server_thread_unblocking(TRUE);
