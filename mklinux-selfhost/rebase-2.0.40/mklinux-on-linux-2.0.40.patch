+#endif	/* CONFIG_OSFMACH3 */
 
 #ifdef CONFIG_DEBUG_MALLOC
 	proc_register(&proc_root, &(struct proc_dir_entry) {
@@ -372,6 +419,10 @@ void proc_root_init(void)
 			S_IFREG | S_IRUGO | S_IWUSR, 1, 0, 0,
