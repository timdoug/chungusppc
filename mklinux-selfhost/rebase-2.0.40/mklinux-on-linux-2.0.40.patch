+/*
+ * MkLinux
+ */
+/*
+ * Common routines to handle CDROMs.
+ */
+
+#include <linux/autoconf.h>
+
+#include <mach/mach_interface.h>
+#include <mach/mach_ioctl.h>
+#include <device/device_request.h>
+#include <device/device.h>
+
+#include <osfmach3/mach_init.h>
