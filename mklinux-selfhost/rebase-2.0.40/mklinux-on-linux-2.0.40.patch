+	/*
+	 * Make the server unswappable (but it's still pageable).
+	 */
+	kr = task_swappable(privileged_host_port, mach_task_self(), FALSE);
+	if (kr != KERN_SUCCESS) {
+		MACH3_DEBUG(1, kr, ("setup_server: task_swappable"));
