+	}
+}
+
+/*
+ *
+ *
+ */
+static 
+dev_reply_t awacs_read_reply(awacs_devc_t *devc, kern_return_t rc, char *data, unsigned int count)
+{
+#ifdef AWACS_DEBUG
+	printk("awacs_read_reply(%08x,%d) - %s %d\n\r", (int) data, (int) count, __FILE__, __LINE__); 
+#endif 
