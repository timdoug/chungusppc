+void
+hide_cursor()
+{
+	unsigned long flags;
+
+	save_flags(flags);
+	cli();
+	if (cursor_pos != -1) {
+		invert_cursor(-1);
+		cursor_pos = -1;
+	}
+	restore_flags(flags);
+}
+
+void
+set_cursor(int currcons)
+{
+	unsigned long flags;
+	int old_cursor;
+
+	if (currcons != fg_console || console_blanked)
+		return;
+
+	save_flags(flags);
+	cli();
+	if (!deccm) {
+		hide_cursor();
+	} else {
+		old_cursor = cursor_pos;
+		cursor_pos = (pos - video_mem_base) >> 1;
+		if (old_cursor != -1)
+			invert_cursor(-1);
+		invert_cursor(cursor_pos);
+	}
+	restore_flags(flags);
+}
