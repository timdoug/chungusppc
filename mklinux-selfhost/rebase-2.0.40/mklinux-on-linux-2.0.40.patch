+/* change a pid into a task struct. */
+static inline struct task_struct * get_task(int pid)
+{
+	int i;
+
+	for (i = 1; i < NR_TASKS; i++) {
+		if (task[i] != NULL && (task[i]->pid == pid))
+			return task[i];
+	}
+	return NULL;
+}
+
+/*
+ * Get contents of register REGNO in task TASK.
+ */
+static inline long get_reg(struct task_struct *task, int regno)
+{
+#ifdef	CONFIG_OSFMACH3
+	struct pt_regs *regs = task->osfmach3.thread->regs_ptr;
+	struct pt_regs *extra_regs = (struct pt_regs *)regs->pt_extra_regs;
+#else	/* CONFIG_OSFMACH3 */
+	struct pt_regs *regs = task->tss.regs;
+#endif	/* CONFIG_OSFMACH3 */
+	if (regno <= PT_R31)
+	{
+		return (regs->gpr[regno]);
+	} else
+	if (regno == PT_ORIG_R3)
+	{
+		if (extra_regs) {
+			return (extra_regs->orig_gpr3);
+		} 
+	} else
+	if (regno == PT_NIP)
+	{
+		return (regs->nip);
+	} else
+	if (regno == PT_MSR)
+	{
+		return (regs->msr);
+	} else
+	if (regno == PT_CTR)
+	{
+		return (regs->ctr);
+	} else
+	if (regno == PT_LNK)
+	{
+		return (regs->link);
+	} else
+	if (regno == PT_XER)
+	{
+		return (regs->xer);
+	} else
+	if (regno == PT_CCR)
+	{
+		return (regs->ccr);
+	}
+	return (0);
+}
+
+/*
+ * Write contents of register REGNO in task TASK.
+ */
+static inline int put_reg(struct task_struct *task, int regno,
+			  unsigned long data)
+{
+#ifdef	CONFIG_OSFMACH3
+	struct pt_regs *regs = task->osfmach3.thread->regs_ptr;
+#else	/* CONFIG_OSFMACH3 */
+	struct pt_regs *regs = task->tss.regs;
+#endif	/* CONFIG_OSFMACH3 */
+	if (regno <= PT_R31)
+	{
+		regs->gpr[regno] = data;
+	} else
+	if (regno == PT_NIP)
+	{
+		regs->nip = data;
+	} else
+	if (regno == PT_MSR)
+	{
+		regs->msr = data;
+	} else
+	if (regno == PT_CTR)
+	{
+		regs->ctr = data;
+	} else
+	if (regno == PT_LNK)
+	{
+		regs->link = data;
+	} else
+	if (regno == PT_XER)
+	{
+		regs->xer = data;
+	} else
+	if (regno == PT_CCR)
+	{
+		regs->ccr = data;
+	} else
+	{ /* Invalid register */
+		return (-1);
+	}
+	return (0);
+}
