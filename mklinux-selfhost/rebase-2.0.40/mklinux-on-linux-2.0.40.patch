+	printk("... Call backtrace:\n");
+	while (*sp)
+	{
+#ifdef	CONFIG_OSFMACH3
+		printk("%08lX ", sp[1]);
+		sp = (unsigned long *) *sp;
+#else	/* CONFIG_OSFMACH3 */
+		printk("%08X ", sp[1]);
+		sp = *sp;
+#endif	/* CONFIG_OSFMACH3 */
+		if (++cnt == 8)
+		{
+			printk("\n");
+		}
+		if (cnt > 16) break;
+	}
+	printk("\n");
+}
