+#ifdef	CONFIG_OSFMACH3
+#define proc_register(dir,a1,a2,a3,a4,a5,a6,a7,a8) \
+{ \
+	static struct proc_dir_entry xxx; \
+	xxx = *(a1,a2,a3,a4,a5,a6,a7,a8); \
