 		break;
 	default:
 	case POWERMAC_CLASS_PCI:
diff --git a/src/mach_kernel/ppc/POWERMAC/interrupt_performa.c b/src/mach_kernel/ppc/POWERMAC/interrupt_performa.c
index 33a5a34..cc93372 100644
--- a/src/mach_kernel/ppc/POWERMAC/interrupt_performa.c
+++ b/src/mach_kernel/ppc/POWERMAC/interrupt_performa.c
@@ -168,10 +168,15 @@ struct powermac_interrupt performa_via1_portb_interrupts[8] = {
 };
 
 
+/* The cascaded slot interrupt (which carries the F108's IDE and video lines)
+ * arrives on VIA2 IFR bit 1, "any slot" - the same bit the M2 handler this was
+ * adapted from uses, and the level-2 slot request described in the developer
+ * note. The handler had been left one slot too low, on bit 2, so the scan never
+ * reached it and disk interrupts were dropped. */
 struct powermac_interrupt performa_via2_interrupts[8] = {
 		{ 0,		0,	-1 },			/* SCSI DMA IRQ (not used) */
-		{ 0, 		0,	-1 },			/* any slot */
- {performa_via2_slot_interrupt,	0,	-1},			/* reserved (0) */
+ {performa_via2_slot_interrupt,	0,	-1},			/* any slot */
+		{ 0, 		0,	-1 },			/* reserved (0) */
 		{ 0,		0,	PMAC_DEV_SCSI0 },	/* SCSI IRQ */
 		{ 0,		0,	PMAC_DMA_AUDIO_OUT },	/* Really Sound IRQ!!! */
 		{ 0, 		0,	-1 },			/* any button */
@@ -324,7 +329,16 @@ printf("interrupt_initialize called.  Setting PERFORMA_ICR\n");
 		PERFORMA_CAPELLA_SIZE);
 	*(v_u_long*)(capella_base_virt + CAPELLA_INT_REG_OFFSET) = 0x00;
 #else
-	capella_base_virt = POWERMAC_IO(PERFORMA_CAPELLA_BASE_PHYS);
+	/* Capella sits at 0x53000000, outside the POWERMAC_IO() BAT window that
+	 * only covers the 0x50f00000 I/O block, so POWERMAC_IO() hands back an
+	 * unbacked virtual address; the store below then faults and the 5200/6200
+	 * spins here during boot. Map Capella explicitly first, the way the
+	 * disabled branch above and the shipped 5 Aug 2000 Performa kernel do. */
+	(void)pmap_add_physical_memory(PERFORMA_CAPELLA_BASE_PHYS,
+		(PERFORMA_CAPELLA_BASE_PHYS + PERFORMA_CAPELLA_SIZE),
+		FALSE, PTE_WIMG_IO);
+	capella_base_virt = io_map(PERFORMA_CAPELLA_BASE_PHYS,
+		PERFORMA_CAPELLA_SIZE);
 	*(v_u_long*)(capella_base_virt + CAPELLA_INT_REG_OFFSET) = 0x00;
 #endif
 
diff --git a/src/mach_kernel/ppc/POWERMAC/powermac_performa.h b/src/mach_kernel/ppc/POWERMAC/powermac_performa.h
index 908b7f2..7842a6f 100644
--- a/src/mach_kernel/ppc/POWERMAC/powermac_performa.h
+++ b/src/mach_kernel/ppc/POWERMAC/powermac_performa.h
@@ -91,7 +91,11 @@
 
 /* Fish 'n' Chips */
 
-#define PERFORMA_CUDA_BASE_PHYS	(0x50f16000)
+/* Cuda is reached through VIA1 (its register offsets - shift at +0x1400,
+   IFR at +0x1a00 - are VIA registers), so its base is the VIA1/PMU base at
+   PERFORMA_IO_BASE_ADDR. The old 0x50f16000 pointed into the SWIM floppy
+   register block, so cudaprobe() hung waiting for a TREQ that never came. */
+#define PERFORMA_CUDA_BASE_PHYS	(PERFORMA_IO_BASE_ADDR)
 #define PERFORMA_CAPELLA_BASE_PHYS (0x53000000)
 #define PERFORMA_CAPELLA_SIZE (0x01000000)
 #define CAPELLA_INT_REG_OFFSET (0x18)
