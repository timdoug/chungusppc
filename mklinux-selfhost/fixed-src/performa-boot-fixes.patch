diff --git a/src/mach_kernel/ppc/POWERMAC/adb.c b/src/mach_kernel/ppc/POWERMAC/adb.c
index 2a69d2a..ce817e8 100644
--- a/src/mach_kernel/ppc/POWERMAC/adb.c
+++ b/src/mach_kernel/ppc/POWERMAC/adb.c
@@ -754,7 +754,16 @@ adb_send(adb_request_t *adb, boolean_t wait)
 {
 	spl_t	s;
 
-	if (!adb_polling) 
+	/* On machines whose ADB completion interrupt is not delivered (the
+	   Performa), adb_always_poll is set so every request is polled to
+	   completion. Various drivers toggle adb_polling off after their own
+	   critical sections without honoring adb_always_poll, so re-assert it
+	   here - otherwise a synchronous request would sleep forever waiting
+	   for an interrupt that never arrives. */
+	if (adb_always_poll)
+		adb_polling = TRUE;
+
+	if (!adb_polling)
 		s  = spltty();
 
 	simple_lock(&adb_lock);
