-		    pmac_register_int(PMAC_DEV_SCC, SPLTTY,
-				      (void (*)(int, void *))scc_intr);
+		    /* The 5200/6200 SCC interrupt is not wired into any of the
+		       active Performa VIA/F108 interrupt tables (it lived only
+		       in the disabled ICR table in interrupt_performa.c), so
+		       registering PMAC_DEV_SCC panics performa_register_int.
+		       The console is the Valkyrie framebuffer; run the serial
+		       ports polled (output works) rather than register an
+		       unsupported interrupt. */
+		    if (powermac_info.class != POWERMAC_CLASS_PERFORMA)
+			pmac_register_int(PMAC_DEV_SCC, SPLTTY,
+					  (void (*)(int, void *))scc_intr);
 		    break;
 
 		case	POWERMAC_CLASS_PCI:
