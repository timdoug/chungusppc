+/*
+ * MkLinux
+ */
+
+/*
+ * Pseudo-DMA backend for the Power Macintosh 5200/6200 (Performa) Curio SCSI.
+ *
+ * These machines have no SCSI DMA engine. The F108/PrimeTime glue instead
+ * provides a pseudo-DMA "handshake" port: the processor reads or writes that
+ * single address in a tight loop and the hardware paces each access against
+ * the 53CF94's DREQ/DACK. So unlike the AMIC and DBDMA backends, which program
+ * an engine and return, dma_start_transfer here does the copy itself. When it
+ * returns the chip's transfer counter has reached zero, and the normal
+ * terminal-count interrupt drives the rest of the state machine.
+ *
+ * asc_get_io() hands this backend a kernel virtual address (not the physical
+ * one a real DMA engine wants) with an eight-byte aligned count, so the copy
+ * moves whole 32-bit words with no misaligned tail.
+ */
+
+#include <asc.h>
+
+#if     NASC > 0
+#include <platforms.h>
+#include <ppc/proc_reg.h> /* For eieio */
+#include <mach_debug.h>
+#include <kern/spl.h>
+#include <mach/std_types.h>
+#include <types.h>
+#include <chips/busses.h>
+#include <ppc/POWERMAC/powermac.h>
+#include <ppc/POWERMAC/powermac_performa.h>
+#include <ppc/POWERMAC/scsi_53C94.h>
+
+/* The handshake port sits one 256-byte window past the register block. */
+#define	PERFORMA_ASC_PDMA_PHYS	(PERFORMA_ASC_BASE_PHYS + 0x100)
+
+void	scsi_curio_pdma_init(int unit);
+void	scsi_curio_pdma_setup(int unit, vm_offset_t address,
+				vm_size_t len, boolean_t isread);
+void	scsi_curio_pdma_start(int unit, boolean_t isread);
+void	scsi_curio_pdma_end(int unit, boolean_t isread);
+
+scsi_curio_dma_ops_t	scsi_curio_pdma_ops = {
+	scsi_curio_pdma_init,
+	scsi_curio_pdma_setup,
+	scsi_curio_pdma_start,
+	scsi_curio_pdma_end
+};
+
+struct pdma_softc {
+	volatile unsigned long	*port;	/* the handshake port */
+	unsigned long		*addr;	/* current buffer (kernel virtual) */
+	vm_size_t		len;	/* byte count for this chunk */
+} scsi_curio_pdma_softc[NASC];
+
+
+void
+scsi_curio_pdma_init(int unit)
+{
+	scsi_curio_pdma_softc[unit].port =
+		(volatile unsigned long *) POWERMAC_IO(PERFORMA_ASC_PDMA_PHYS);
+}
+
+void
+scsi_curio_pdma_setup(int unit, vm_offset_t address, vm_size_t len,
+			boolean_t isread)
+{
+	struct pdma_softc	*p = &scsi_curio_pdma_softc[unit];
+
+	p->addr = (unsigned long *) address;
+	p->len  = len;
+}
+
+void
+scsi_curio_pdma_start(int unit, boolean_t isread)
+{
+	struct pdma_softc	*p = &scsi_curio_pdma_softc[unit];
+	volatile unsigned long	*port = p->port;
+	unsigned long		*data = p->addr;
+	vm_size_t		words = p->len >> 2;
+
+	/*
+	 * The count is eight-byte aligned, so it divides evenly into words.
+	 * Each access to the fixed port moves the next word to or from the
+	 * chip's FIFO; the hardware handshake supplies the pacing.
+	 */
+	if (isread) {
+		while (words-- > 0) {
+			*data++ = *port;
+			eieio();
+		}
+	} else {
+		while (words-- > 0) {
+			*port = *data++;
+			eieio();
+		}
+	}
+}
+
+void
+scsi_curio_pdma_end(int unit, boolean_t isread)
+{
+	/*
+	 * The transfer finished synchronously in start(); the chip raised its
+	 * terminal-count interrupt on its own. Nothing to flush: the processor
+	 * did the copy, so the data is already coherent with its own accesses.
+	 */
+}
+
+#endif 	/* NASC > 0 */
